model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  vatRate     Decimal? @map("vat_rate") @db.Decimal(5, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]

  @@index([isActive])
  @@map("categories")
}

model Marca {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]

  @@index([isActive])
  @@map("brands")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(150)
  description String?  @db.Text
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  stock       Int      @default(0)
  categoryId  String   @map("category_id") @db.Uuid
  brandId     String   @map("brand_id") @db.Uuid
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand    Marca    @relation(fields: [brandId], references: [id], onDelete: Restrict)
  batches  Batch[]

  @@index([name])
  @@index([categoryId])
  @@index([brandId])
  @@index([isActive])
  @@map("products")
}

// Lote de un producto registrado en una entrada de inventario (HU-02).
model Batch {
  id              String   @id @default(uuid()) @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  code            String   @db.VarChar(50)
  expirationDate  DateTime @map("expiration_date") @db.Date
  initialQuantity Int      @map("initial_quantity")
  availableQuantity Int    @default(0) @map("available_quantity")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([expirationDate])
  @@map("batches")
}
