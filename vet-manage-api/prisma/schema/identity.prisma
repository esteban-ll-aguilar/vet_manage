enum RoleCategory {
  SYSTEM
  STAFF
  CLIENT
}

// Estado de un registro: activo, inactivo o dado de baja.
enum RecordStatus {
  ACTIVE
  INACTIVE
  DEACTIVATED
}

model Person {
  id             String   @id @default(uuid()) @db.Uuid
  identification String   @unique @db.VarChar(10)
  firstName      String   @map("first_name") @db.VarChar(100)
  lastName       String   @map("last_name") @db.VarChar(100)
  email          String   @unique @db.VarChar(255)
  phone          String?  @db.VarChar(20)
  address        String?  @map("address") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user   User?
  client Client?

  @@index([lastName, firstName])
  @@map("persons")
}

// Cliente del consultorio. La información de contacto vive en Person;
// este modelo conserva el estado propio del cliente.
model Client {
  id        String       @id @default(uuid()) @db.Uuid
  personId  String       @unique @map("person_id") @db.Uuid
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  // Baja definitiva (HU-03): cuándo, quién y por qué. Nulos mientras el cliente no esté de baja.
  deactivatedAt      DateTime? @map("deactivated_at")
  deactivatedById    String?   @map("deactivated_by_id") @db.Uuid
  deactivationReason String?   @map("deactivation_reason") @db.VarChar(500)

  person        Person    @relation(fields: [personId], references: [id], onDelete: Restrict)
  deactivatedBy User?     @relation("ClientDeactivatedBy", fields: [deactivatedById], references: [id], onDelete: Restrict)
  patients      Patient[]

  @@index([status])
  @@map("clients")
}

model User {
  id                  String       @id @default(uuid()) @db.Uuid
  personId            String       @unique @map("person_id") @db.Uuid
  password            String?      @db.VarChar(255)
  status              RecordStatus @default(ACTIVE)
  deactivatedAt       DateTime?    @map("deactivated_at")
  deactivationReason  String?      @map("deactivation_reason") @db.Text
  // Intentos fallidos consecutivos de inicio de sesión.
  failedLoginAttempts Int          @default(0) @map("failed_login_attempts")
  isLocked            Boolean      @default(false) @map("is_locked")
  lockedAt            DateTime?    @map("locked_at")
  mustChangePassword  Boolean      @default(false) @map("must_change_password")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  person            Person        @relation(fields: [personId], references: [id], onDelete: Restrict)
  sessions          UserSession[]
  passwordResetTokens PasswordResetToken[]
  userRoles         UserRole[]
  createdRoles      Role[]        @relation("RoleCreatedBy")
  assignedUserRoles UserRole[]    @relation("UserRoleAssignedBy")
  auditLogs         AuditLog[]
  deactivatedClients Client[]     @relation("ClientDeactivatedBy")

  // agendamiento de Citas
  horariosBase           HorarioBase[]      @relation("HorarioBaseVeterinario")
  bloqueosVeterinario    BloqueoHorario[]   @relation("BloqueoHorarioVeterinario")
  bloqueosRegistrados    BloqueoHorario[]   @relation("BloqueoHorarioRegistradoPor")
  bloqueosEliminados     BloqueoHorario[]   @relation("BloqueoHorarioEliminadoPor")
  citasComoVeterinario   Cita[]             @relation("CitaVeterinario")
  citasRegistradas       Cita[]             @relation("CitaRegistradaPor")
  cambiosEstadoCita      CambioEstadoCita[] @relation("CambioEstadoCitaRealizadoPor")
  reprogramaciones       Reprogramacion[]   @relation("ReprogramacionRealizadaPor")
  pagosRegistrados       Pago[]             @relation("PagoRegistradoPor")
  reembolsosAutorizados  OrdenReembolso[]   @relation("OrdenReembolsoAutorizadaPor")
  devolucionesRealizadas Devolucion[]       @relation("DevolucionRealizadaPor")
  ofertasTurno           OfertaTurno[]      @relation("OfertaTurnoVeterinario")
  notifications          Notification[]

  @@index([status])
  @@map("users")
}

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String?   @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(128)
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  ipAddress        String?   @map("ip_address") @db.VarChar(45)
  userAgent        String?   @map("user_agent") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt, revokedAt])
  @@map("user_sessions")
}

// Enlaces de recuperación de contraseña (HU-58): solo se guarda el hash del token.
model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  replacedAt DateTime? @map("replaced_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Role {
  id                    String       @id @default(uuid()) @db.Uuid
  name                  String       @unique @db.VarChar(50)
  displayName           String       @map("display_name") @db.VarChar(150)
  description           String?      @db.Text
  isSystem              Boolean      @default(false) @map("is_system")
  isActive              Boolean      @default(true) @map("is_active")
  isVisible             Boolean      @default(true) @map("is_visible")
  permissionsCustomized Boolean      @default(false) @map("permissions_customized")
  category              RoleCategory @default(STAFF) @map("role_category")
  organizationId        String?      @map("organization_id") @db.Uuid
  createdById           String?      @map("created_by_id") @db.Uuid
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  createdBy       User?            @relation("RoleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@index([organizationId])
  @@index([name])
  @@index([category])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  module      String   @db.VarChar(100)
  action      String   @db.VarChar(100)
  displayName String   @map("display_name") @db.VarChar(150)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  isVisible   Boolean  @default(true) @map("is_visible")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@unique([module, action], name: "permission_module_action_key")
  @@index([isActive])
  @@map("permissions")
}

model UserRole {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  roleId         String    @map("role_id") @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  assignedById   String?   @map("assigned_by_id") @db.Uuid
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("UserRoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([userId, roleId, organizationId], name: "user_role_organization_key")
  @@index([userId])
  @@index([roleId])
  @@index([organizationId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  grantedAt    DateTime @default(now()) @map("granted_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}